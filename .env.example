# Use adb reverse para acessar os serviços do computador por USB/emulador.
EXPO_PUBLIC_AUTH_URL=http://127.0.0.1:8080
EXPO_PUBLIC_MAIN_URL=http://127.0.0.1:8070
EXPO_PUBLIC_LOAD_URL=http://127.0.0.1:8090
EXPO_PUBLIC_CHAT_URL=http://127.0.0.1:5000

# EAS project UUID used to register native push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Path to the local Firebase Android configuration; do not commit the file.
GOOGLE_SERVICES_FILE=
