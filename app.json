{
  "expo": {
    "name": "Inteliagent",
    "slug": "inteliagent-app",
    "owner": "rian123r",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "inteliagent-app",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F7"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1C1C"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.rian3054.inteliagentapp",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": "Permitir que o Inteliagent grave mensagens de voz."
        }
      ],
      "./plugins/withWindowsCmake.cjs",
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir que o Inteliagent grave mensagens de voz."
        }
      ],
      "expo-notifications",
      "./plugins/withReliableAndroidPush.cjs",
      "./plugins/withLanServer.cjs"
    ],
    "newArchEnabled": true,
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "15c0d89f-a3ef-4ea0-bb25-346c6f119af7"
      }
    }
  }
}
